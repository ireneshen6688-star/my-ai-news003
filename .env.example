# My AI News 003 — 环境变量配置说明
# 在 Cloudflare Pages Dashboard → Settings → Environment Variables 中配置

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=         # Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=     # Google Cloud Console → OAuth 2.0 Client Secret
GOOGLE_REDIRECT_URI=https://myainews.club/api/auth/callback/google
SESSION_SECRET=           # 随机字符串，用于签名 session token（至少32位）

# ── PayPal（沙箱）────────────────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=AVTSmljYtreY0HvcROzbFtnjcxGmCoTFLrQcVF2HHG9nLnQuXQR2iwMB_HPhW92nf0hLAZuidQ_0EDwz
PAYPAL_CLIENT_SECRET=EM1U9Us3wHu3KIb1M3l30GraGPLIk8gEKJfPO82NWaJiInzQJeItvpsU6jtgtad5aLww-5_V4RiKTZUk

# 可选：如果已在 PayPal 后台手动创建了订阅计划，填入 Plan ID 可跳过动态创建
# PAYPAL_PRO_PLAN_ID=P-XXXXXXXXXXXXXXXXXX

# Webhook ID：在 PayPal Dashboard 注册 Webhook 后获取
# URL: https://myainews.club/api/paypal/webhook
# 沙箱阶段可以先不填（跳过签名验证）
# PAYPAL_WEBHOOK_ID=WH-XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── 邮件（Resend）────────────────────────────────────────────────────────────
RESEND_API_KEY=re_3krTVkoc_LQ1ydRivxLfH9xwmwAmdvqtE

# ── 站点 ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://myainews.club
